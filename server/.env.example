# Copy to server/.env and fill in real values. Never commit server/.env.

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/algoarena

# Long random string used to sign login tokens (at least 32 characters in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=5000
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call the API and open sockets
CORS_ORIGIN=http://localhost:3000

# Code execution sandbox: judge0 (default) | docker | disabled
EXECUTION_PROVIDER=judge0
# Public Judge0 CE instance (rate limited, no key needed). For production, use a
# self-hosted Judge0 or https://judge0-ce.p.rapidapi.com with JUDGE0_API_KEY.
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# "Continue with Google": OAuth 2.0 Web client id from Google Cloud Console.
# Leave empty to hide the Google button. (A client id is public; no client secret is needed.)
GOOGLE_CLIENT_ID=

# External problem sources (set to false to disable)
CODEFORCES_ENABLED=true
